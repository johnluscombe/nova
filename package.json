{
    "name": "nova",
    "version": "0.0.1",
    "private": true,
    "description": "Nova radar imagery workspace",
    "keywords": [
        "electron",
        "imagery",
        "radar",
        "sicd"
    ],
    "type": "module",
    "scripts": {
        "lint": "oxlint --fix && oxfmt",
        "lint:check": "oxfmt --check && oxlint",
        "dev": "quasar dev -m electron",
        "build": "quasar build -m electron",
        "typecheck": "vue-tsc --noEmit",
        "postinstall": "quasar prepare --silent",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "quasar build -m electron --skip-pkg && playwright test --project=e2e",
        "test:e2e:ui": "playwright test --project=e2e --ui",
        "test:coverage": "vitest run --coverage",
        "test:e2e:coverage": "cross-env NOVA_COVERAGE=1 npm run test:e2e",
        "test:coverage:all": "shx rm -rf coverage/combined && npm run test:coverage && npm run test:e2e:coverage && npm run coverage:merge",
        "coverage:merge": "shx rm -rf coverage/combined && shx mkdir -p coverage/combined/inputs coverage/combined/merged && shx cp coverage/unit/coverage-final.json coverage/combined/inputs/unit.json && shx cp coverage/playwright/coverage-playwright.json coverage/combined/inputs/playwright.json && nyc merge coverage/combined/inputs coverage/combined/merged/coverage.json && npm run coverage:report",
        "coverage:report": "nyc report --temp-dir coverage/combined/merged --report-dir coverage/combined --exclude-after-remap=false --reporter=text-summary --reporter=html --reporter=lcovonly --reporter=json --reporter=json-summary"
    },
    "dependencies": {
        "@quasar/extras": "^2.1.0",
        "drizzle-orm": "^1.0.0-rc.5",
        "fflate": "^0.8.3",
        "quasar": "^2.35.2",
        "vue": "^3.5.22",
        "vue-router": "^5.0.6"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@quasar/app-vite": "^3.10.3",
        "@types/istanbul-lib-coverage": "^2.0.6",
        "@types/istanbul-lib-instrument": "^1.7.8",
        "@types/istanbul-lib-report": "^3.0.3",
        "@types/istanbul-lib-source-maps": "^4.0.4",
        "@types/istanbul-reports": "^3.0.4",
        "@types/node": "^22.19.11",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vitest/coverage-istanbul": "^5.0.5",
        "@vue/test-utils": "^2.5.1",
        "autoprefixer": "^10.4.27",
        "cross-env": "^10.1.0",
        "istanbul-lib-coverage": "^3.2.2",
        "istanbul-lib-instrument": "^6.0.3",
        "istanbul-lib-report": "^3.0.1",
        "istanbul-lib-source-maps": "^5.0.6",
        "istanbul-reports": "^3.2.0",
        "jsdom": "^31.0.1",
        "nyc": "^18.0.0",
        "oxfmt": "^0.x",
        "oxlint": "^1.x",
        "oxlint-tsgolint": "^7.0.2001",
        "postcss": "^8.5.8",
        "shx": "^0.4.0",
        "typescript": "^6.0.0",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.3"
    },
    "engines": {
        "node": ">= 26 || ^24 || ^22.12"
    },
    "productName": "Nova"
}
